{
  "name": "ai-video-workbench",
  "version": "0.1.2",
  "private": true,
  "license": "MIT",
  "description": "模块化 AI 视频制作桌面工作台",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@8.15.4",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=8.15.4"
  },
  "scripts": {
    "postinstall": "node scripts/media-engine/prepare.mjs && pnpm exec install-electron",
    "prepare:media-engine": "node scripts/media-engine/prepare.mjs",
    "dev": "pnpm prepare:media-engine && electron-vite dev --watch",
    "build": "pnpm prepare:media-engine && electron-vite build",
    "preview": "electron-vite preview",
    "package:win": "pnpm build && electron-builder --win --dir",
    "package:win:empty": "pnpm build && node scripts/package-win.mjs empty",
    "package:win:data": "pnpm build && node scripts/package-win.mjs current",
    "package:win:release": "pnpm build && node scripts/package-win.mjs release",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@floating-ui/dom": "1.7.4",
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "@hookform/resolvers": "6.0.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@tanstack/react-query": "5.104.4",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@xyflow/react": "12.12.0",
    "clsx": "2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sortablejs": "1.15.6",
    "tailwind-merge": "3.7.0",
    "tar": "7.5.22",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/parser": "8.0.7",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.12.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sortablejs": "1.15.9",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "ffmpeg-ffprobe-static": "6.1.1",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
